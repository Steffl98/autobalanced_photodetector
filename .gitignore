# ==========================================
# Project root
# ==========================================

# Ignore everything in project root
/*
!/.gitignore
!/kicad/


# ==========================================
# KiCad temporary files and backups
# ==========================================

# Local user preferences
*.kicad_prl

# Lock files
*.lck

# Automatic backups
*-backups/
_autosave-*
\#auto_saved_files\#
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak

# Cache files
fp-info-cache
*-cache.lib


# ==========================================
# Editor and OS temporary files
# ==========================================

*~
*.swp
*.swo
.DS_Store
Thumbs.db


# ==========================================
# KiCad project files (keep tracked)
# ==========================================

# *.kicad_pro    Project configuration
# *.kicad_sch    Schematics
# *.kicad_pcb    PCB layout
# *.kicad_sym    Custom symbol libraries
# sym-lib-table  Symbol library configuration
# fp-lib-table   Footprint library configuration

# Imported PSU: local vendor libraries and generated import reports
/kicad/Autobalanced_Photodetector/vendor/Eaton/
/kicad/Autobalanced_Photodetector/vendor/Coto/
/kicad/Autobalanced_Photodetector/vendor/OPA659/
/kicad/Autobalanced_Photodetector/vendor/Lorlin/
/kicad/Autobalanced_Photodetector/vendor/TMUX6136/
/kicad/Autobalanced_Photodetector/vendor/OPA4192/
/kicad/Autobalanced_Photodetector/LIB_OPA4192IPWR/
/kicad/Autobalanced_Photodetector/LIB_TMUX6136PWR/
/kicad/Autobalanced_Photodetector/LIB_CK1051/
/kicad/Autobalanced_Photodetector/LIB_OPA659IDRBT/
/kicad/Autobalanced_Photodetector/LIB_9012-12-10/
.history/
